{
  "name": "muscle-graph",
  "version": "0.2.0",
  "description": "Accessible, framework-agnostic advanced SVG muscle maps for male and female bodies.",
  "type": "module",
  "main": "./dist/muscle-graph.umd.cjs",
  "module": "./dist/muscle-graph.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/muscle-graph.js"
      },
      "require": {
        "types": "./dist/types-cjs/index.d.cts",
        "default": "./dist/muscle-graph.umd.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs/advanced-muscles.md",
    "README.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --config website/vite.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/build-cjs-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "security": "npm audit --audit-level=low",
    "check": "npm run typecheck && npm run test && npm run build && node scripts/check-package.mjs && npm run docs:build",
    "prepublishOnly": "npm run check",
    "dev:playground": "vite examples/playground",
    "docs:build": "node scripts/build-website.mjs",
    "docs:preview": "vite preview --config website/vite.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lilbuda/muscle-graph.git"
  },
  "homepage": "https://github.com/lilbuda/muscle-graph#readme",
  "bugs": {
    "url": "https://github.com/lilbuda/muscle-graph/issues"
  },
  "keywords": [
    "muscle",
    "body-map",
    "anatomy",
    "fitness",
    "svg",
    "framework-agnostic",
    "angular"
  ],
  "author": "lilbuda",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
